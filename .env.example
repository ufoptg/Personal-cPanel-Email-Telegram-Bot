# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# The first ID is primary and creates addresses on EMAIL_DOMAIN;
# any other allowed ID creates addresses on SUB_DOMAIN_EMAIL.
ALLOWED_TELEGRAM_IDS=8198750464

# cPanel UAPI (HTTPS, typically port 2083)
CPANEL_HOST=server.example.com
CPANEL_PORT=2083
CPANEL_USER=cpaneluser
CPANEL_API_TOKEN=your_cpanel_api_token
# Set to false only if the host uses a self-signed certificate
CPANEL_VERIFY_SSL=true

# Email domains for new addresses (localpart@domain)
EMAIL_DOMAIN=example.com
SUB_DOMAIN_EMAIL=sub.example.com

# IMAP (usually mail.example.com or same host as cPanel)
IMAP_HOST=mail.example.com
IMAP_PORT=993

# Fernet key for encrypting stored mailbox passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# SQLite database path
DB_PATH=./data/bot.db
