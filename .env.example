# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Comma-separated numeric Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_IDS=123456789

# cPanel UAPI (HTTPS, typically port 2083)
CPANEL_HOST=server.example.com
CPANEL_PORT=2083
CPANEL_USER=cpaneluser
CPANEL_API_TOKEN=your_cpanel_api_token
# Set to false only if the host uses a self-signed certificate
CPANEL_VERIFY_SSL=true

# Email domain for new addresses (localpart@EMAIL_DOMAIN)
EMAIL_DOMAIN=example.com

# IMAP (usually mail.example.com or same host as cPanel)
IMAP_HOST=mail.example.com
IMAP_PORT=993

# Fernet key for encrypting stored mailbox passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# SQLite database path
DB_PATH=./data/bot.db
